      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[0].Sentence
      value: "\u0423\u0445! \u041D\u0435 \u043F\u043B\u043E\u0445\u043E! \u041A\u0430\u0436\u0435\u0442\u0441\u044F
        \u0442\u044B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0433\u043E\u0442\u043E\u0432.
        \u0417\u0430\u0445\u043E\u0434\u0438 \u0432 \u0427\u0410\u0421\u042B \u0437\u0430
        \u043C\u043E\u0438\u043C \u043A\u0438\u043E\u0441\u043A\u043E\u043C, \u043E\u043D\u0438
        \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0443\u0442 \u0442\u0435\u0431\u044F
        \u0432 \u0441\u043D\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u043E\u0435
        \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u0430\u043C\u0438. \u041A\u0430\u043A
        \u0432\u0441\u0435\u0445 \u043F\u043E\u0439\u043C\u0430\u0435\u0448\u044C
        \u0438\u0449\u0438 \u043C\u0435\u043D\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[1].Sentence
      value: "\u041F\u043E\u043D\u044F\u043B. \u041C\u043E\u0433\u0443 \u0438\u0434\u0442\u0438
        ?"
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[2].Sentence
      value: "\u0421\u0442\u043E\u0439, \u0434\u0435\u0440\u0436\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E.
        \u0415\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0437\u0430\u0431\u0443\u0434\u0435\u0448\u044C,
        \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 TAB \u0438 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F
        \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0441 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C.
        \u0415\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u0441\u0435\u043C
        \u0432\u044B\u0434\u0430\u044E\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[3].Sentence
      value: "\u041F\u043B\u044E\u0445 \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C
        \u043D\u0430 \u0441\u043C\u0435\u043D\u0443!!!"
      objectReference: {fileID: 0}
