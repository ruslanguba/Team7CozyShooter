    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[0].Sentence
      value: "\u041F\u0440\u0438\u0432\u0435\u0442, \u041F\u043B\u044E\u0445! \u0417\u0430\u0441\u0442\u0443\u043F\u0438\u043B
        \u043D\u0430 \u0441\u043C\u0435\u043D\u0443?"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[1].Sentence
      value: "\u0414\u0430, \u043C\u043E\u0435\u043C\u0443 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0443
        \u0441\u043D\u043E\u0432\u0430 \u0441\u043D\u044F\u0442\u0441\u044F \u043A\u043E\u0448\u043C\u0430\u0440\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[2].Sentence
      value: "\u041D\u0443, \u043F\u043E\u043B\u0443\u0447\u0430\u0439 \u0441\u0432\u043E\u0439
        \u043F\u043E\u0434\u0443\u0448\u043A\u043E\u043C\u0435\u0442. \u041D\u0430\u043F\u043E\u043C\u043D\u0438,
        \u043A\u0430\u043A \u0442\u044B  \u0435\u0433\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[3].Sentence
      value: "\u041C\u043E\u044F \u0442\u0438\u0445\u043E\u0431\u043E\u0439\u043A\u0430 
        \u0425\u0430\u0445\u0430\u0445\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[4].Sentence
      value: "\u0422\u0430\u043A \u0434\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043C
        \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436, \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F
        \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430, \u043D\u0443 \u0442\u044B
        \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C..."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[5].Sentence
      value: "\u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[6].Sentence
      value: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u0441\u043D\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
        \u0438 \u041F\u041E\u0419\u041C\u0410\u0419 \u0432 \u043D\u0435\u043C \u0412\u0421\u0415\u0425
        \u041A\u041E\u0428\u041C\u0410\u0420\u0418\u041A\u041E\u0412. \u0412 \u0432\u0435\u0440\u0445\u043D\u0435\u043C
        \u0443\u0433\u043B\u0443 \u0443\u0441\u0442\u044C \u0421\u0427\u0415\u0422\u0427\u0418\u041A
        \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u043E\u0432, \u0442\u044B
        \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u0435\u0448\u044C
        \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u043E\u0432 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
        \u043F\u043E\u0439\u043C\u0430\u0442\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[7].Sentence
      value: "\u041E, \u044D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u043E\u0435,
        \u0443\u0434\u043E\u0431\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[8].Sentence
      value: "\u041F\u043E \u0422\u0438\u0445\u043E\u0431\u043E\u0439\u043A\u0435
        \u0432\u0441\u0435 \u043F\u043E \u0441\u0442\u0430\u0440\u043E\u043C\u0443.
        \u041F\u0420\u0410\u0412\u0410\u042F \u041A\u041E\u041D\u041E\u041F\u041A\u0410
        \u043C\u044B\u0448\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F,
        \u041B\u0415\u0412\u0410\u042F \u0441\u0442\u0440\u0435\u043B\u044C\u043D\u0443\u0442\u044C. 
        \u041D\u0430 \u041F\u0420\u041E\u0411\u0415\u041B \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
        \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C. \u041A\u041E\u041B\u0415\u0421\u0418\u041A\u041E\u041C
        \u043C\u044B\u0448\u0438 \u043E\u0442\u0434\u0430\u043B\u0438\u0442\u044C
        \u0438\u043B\u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C
        \u0432\u0438\u0434. \u0422\u0430\u043A \u0432\u0440\u043E\u0434\u0435 \u0432\u0441\u0435..."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[9].Sentence
      value: "\u0422\u0438\u0445\u043E\u0431\u043E\u0439\u043A\u0430 \u043F\u043E
        \u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442
        \u0432\u0432\u0435\u0440\u0445 \u0438 \u0432\u043D\u0438\u0437, \u0442\u043E\u043B\u044C\u043A\u043E
        \u0432\u043F\u0435\u0440\u0435\u0434 ?"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[10].Sentence
      value: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0434\u0430.
        \u041D\u0430\u0448\u0438 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u044B
        \u0432\u0441\u0435 \u0435\u0449\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
        \u043D\u0430\u0434 \u044D\u0442\u0438\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[11].Sentence
      value: "\u041F\u043E\u043D\u044F\u043B, \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C,
        \u0441\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[12].Sentence
      value: "\u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F
        \u0442\u0432\u043E\u0439 \u043D\u0430\u0441\u0442\u0440\u043E\u0439. \u0414\u0430\u0432\u0430\u0439
        \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u0442\u0432\u043E\u0438
        \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u044B, \u043F\u0440\u043E\u0445\u043E\u0434\u0438
        \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443. \u041A\u0430\u043A \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C
        \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u043A\u043E
        \u043C\u043D\u0435, \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u043A\u043E\u0435
        \u0447\u0442\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[13].Sentence
      value: "\u0417\u0432\u0443\u0447\u0438\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
        \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u0435\u043B\u0430\u0442\u044C
        ?"
