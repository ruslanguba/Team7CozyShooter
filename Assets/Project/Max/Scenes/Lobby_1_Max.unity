    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[0].Sentence
      value: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0448\u044C,
        \u0434\u0443\u043C\u0430\u044E \u0442\u0435\u0431\u0435 \u0441\u0442\u043E\u0438\u0442
        \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u0440\u043E
        \u043A\u043E\u043D\u043A\u0443\u0440\u0441 \u043D\u0430 \u0437\u0432\u0430\u043D\u0438\u0435
        \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0448\u0435\u0440\u0438\u0444\u0430
        \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[1].Sentence
      value: "\u0427\u0442\u043E \u0437\u0430 \u043A\u043E\u043D\u043A\u0443\u0440\u0441
        ? \u0427\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u0435\u043B\u0430\u0442\u044C
        ?"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[2].Sentence
      value: "\u041F\u043E\u043A\u0430\u0436\u0438 \u0432\u044B\u0441\u0448\u0438\u0439
        \u043F\u0438\u043B\u043E\u0442\u0430\u0436! \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
        \u043E\u0442\u0441\u043A\u043E\u043A\u0438 \u043E\u0442 \u0441\u0442\u0435\u043D
        \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
        \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u0441\u0430\u043C\u044B\u0445
        \u043D\u0435\u0443\u043B\u043E\u0432\u0438\u043C\u044B\u0445 \u043A\u043E\u0448\u043C\u0430\u0440\u0438\u043A\u043E\u0432."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[3].Sentence
      value: "\u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0439 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E
        - \u0446\u0435\u043B\u044C\u0441\u044F \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
        \u043B\u0443\u0447 \u0441\u043D\u043E\u0432 \u043E\u0442\u0440\u0438\u043A\u043E\u0448\u0435\u0442\u0438\u043B
        \u0438 \u043F\u043E\u043F\u0430\u043B \u0432 \u0446\u0435\u043B\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[4].Sentence
      value: "\u041F\u043E\u0439\u043C\u0430\u0439 \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u0430
        - \u0442\u0430\u043A\u0438\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
        \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u0414\u041E\u041F\u041E\u041B\u041D\u0418\u0422\u041B\u042C\u041D\u042B\u0415
        \u041E\u0427\u041A\u0418!"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[5].Sentence
      value: "\u0423\u0434\u0438\u0432\u0438 \u0432\u0441\u0435\u0445 - \u0442\u043E\u043B\u044C\u043A\u043E
        \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0439 \u043C\u0430\u0441\u0442\u0435\u0440
        \u043C\u043E\u0436\u0435\u0442 \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
        \u0441\u043E\u043D \u043E\u0434\u043D\u0438\u043C \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u043C
