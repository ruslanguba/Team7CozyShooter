      propertyPath: sentence.Array.data[2].Sentence
      value: "\u0411\u044B\u0441\u0442\u0440\u043E \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C\u0441\u044F.
