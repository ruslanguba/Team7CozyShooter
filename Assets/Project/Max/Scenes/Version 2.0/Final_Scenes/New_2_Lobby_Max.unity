      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[4].IsPluh
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[5].IsPluh
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[0].Sentence
      value: "\u041F\u043B\u044E\u0445, \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
        \u0441\u043D\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
        \u043D\u043E\u0432\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442.\n\u0412\u0438\u0436\u0443,
        \u0442\u044B \u0443\u0436\u0435 \u043D\u0430\u0448\u0435\u043B \u043E\u0434\u043D\u0443
        \u043F\u043E\u0434\u0443\u0448\u043A\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[1].Sentence
      value: "\u041D\u043E\u0432\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
        - \u044D\u0442\u043E \u043F\u043E\u0434\u0443\u0448\u043A\u0430? \u0425\u0430-\u0445\u0430-\u0445\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[2].Sentence
      value: "\u041F\u043E\u0434\u0443\u0448\u043A\u0430 - \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430,
        \u0434\u0430! \n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0435\u0451,
        \u0435\u0441\u043B\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
        \u0434\u043E\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C.\n\u041F\u0440\u043E\u0445\u043E\u0434\u0438
        \u0432 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u0443\u044E
        \u0437\u043E\u043D\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[3].Sentence
      value: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439, \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C
        \u0434\u043E \u0447\u0430\u0441\u043E\u0432! \u041F\u043E\u043C\u043D\u0438,
        Tab, \u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
        \u0442\u0443\u0442 \u043A\u0430\u043A \u0442\u0443\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[4].Sentence
      value: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439, \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C
        \u0434\u043E \u0447\u0430\u0441\u043E\u0432! \u041F\u043E\u043C\u043D\u0438,
        Tab, \u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
        \u0442\u0443\u0442 \u043A\u0430\u043A \u0442\u0443\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[5].Sentence
      value: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439, \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C
        \u0434\u043E \u0447\u0430\u0441\u043E\u0432! \u041F\u043E\u043C\u043D\u0438,
        Tab, \u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
        \u0442\u0443\u0442 \u043A\u0430\u043A \u0442\u0443\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 8826465643194921373, guid: f4d12ee87e61f6948966be90e44d7593, type: 3}
      propertyPath: sentence.Array.data[6].Sentence
      value: "\u041E\u0441\u0432\u0430\u0438\u0432\u0430\u0439\u0441\u044F. \u0414\u0435\u0440\u0436\u0438
        \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E \u0441 \u0441\u043E\u0431\u043E\u0439,
        \u0432\u0441\u0435 \u0442\u0430\u043A\u0436\u0435 \u043D\u0430 TAB. \u0414\u043E\u0431\u0435\u0440\u0438\u0441\u044C
        \u0434\u043E \u043C\u043E\u0438\u0445 \u0447\u0430\u0441\u043E\u0432."
      objectReference: {fileID: 0}
