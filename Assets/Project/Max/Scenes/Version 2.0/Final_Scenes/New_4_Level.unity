    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[0].Sentence
      value: "\u041F\u043B\u044E\u0445! \u041A\u0430\u043A \u0432\u044B\u0441\u043E\u043A\u043E
        \u0442\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F! \u041A\u0430\u043A
        \u0443\u0441\u043F\u0435\u0445\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[1].Sentence
      value: "\u0412\u0441\u0435\u0445 \u043F\u043E\u0439\u043C\u0430\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[2].Sentence
      value: "\u0423\u0445, \u0448\u0443\u0441\u0442\u0440\u044F\u043A! \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
        \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0447\u043A\u043E\u0432
        \u0442\u044B \u043D\u0430\u0431\u0440\u0430\u043B... \u041E\u0433\u043E,
        \u0441\u043E\u043B\u0438\u0434\u043D\u043E! \n\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C,
        \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0439\u0442\u0438
        \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
        \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u0441\u0432\u043E\u0439
        \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442! "
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[3].Sentence
      value: "\u0423 \u043D\u0430\u0441 \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0437\u0430\u0434\u0430\u043D\u0438\u0439
        \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E
        \u0437\u0430 \u0441\u043B\u0443\u0436\u0431\u0443! "
      objectReference: {fileID: 0}
