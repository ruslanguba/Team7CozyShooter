    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[0].Sentence
      value: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
        \u041F\u043B\u044E\u0445! \n\u041F\u043E\u0440\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F
        \u0447\u0435\u043C\u0443-\u0442\u043E \u043D\u043E\u0432\u043E\u043C\u0443.\n\u041F\u0440\u044B\u0433\u0430\u0439
        \u0432 \u0447\u0430\u0441\u044B!"
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
      propertyPath: sentence.Array.data[1].Sentence
      value: "\u041F\u0440\u044B\u0433\u0430\u0439 \u0432 \u0447\u0430\u0441\u044B,
        \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C
        \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0441\u043E\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 4222001605948369635, guid: 0c57df96f6e90b149a41c9367b29a7eb, type: 3}
